# ==========================================
# Unity Default .gitignore
# ==========================================

# Pastas temporárias e de cache geradas pelo Unity (NÃO ENVIAR)
/[L|l]ibrary/
/[T|t]emp/
/[O|o]bj/
/[B|b]uild/
/[B|b]uilds/
/[L|l]ogs/
/[M|m]emoryCaptures/
/[U|u]ser[S|s]ettings/

# Asset store packages (pacotes importados)
AssetStoreTools*

# Autogenerated VS/VSCode/Rider project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.idb

# Unity3D Generated Builds
*.apk
*.aab
*.unitypackage
*.app

# Ficheiros do Visual Studio e VS Code
.vs/
.vscode/

# Ficheiros do sistema operacional
.DS_Store
.DS_Store?
ehthumbs.db
Thumbs.db
[D|d]esktop.ini

# Crash Reports
sysinfo.txt

# Ficheiros do Builds da Web (se aplicável)
/[R|r]ecordings/
